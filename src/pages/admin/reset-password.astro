---
export const prerender = false;

import "../../styles/main.css";

const token = Astro.url.searchParams.get("token");
---

<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>管理面板 - 重置密码</title>
    <style is:global>
        @reference "tailwindcss";
    </style>
</head>
<body class="min-h-screen bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
    <div class="w-full max-w-sm">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-8">
            <h1 class="text-2xl font-bold text-center text-gray-900 dark:text-white mb-6">
                重置密码
            </h1>

            {token ? (
                <form id="reset-form">
                    <input type="hidden" id="token" value={token} />
                    <div class="mb-4">
                        <label for="new-password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            新密码
                        </label>
                        <input
                            type="password"
                            id="new-password"
                            name="new-password"
                            required
                            minlength="8"
                            class="w-full px-3 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-blue-500"
                            placeholder="请输入新密码（至少8位）"
                        />
                    </div>
                    <div class="mb-4">
                        <label for="confirm-password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            确认密码
                        </label>
                        <input
                            type="password"
                            id="confirm-password"
                            name="confirm-password"
                            required
                            minlength="8"
                            class="w-full px-3 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-blue-500"
                            placeholder="请再次输入新密码"
                        />
                    </div>
                    <p id="error-msg" class="text-red-500 text-sm mb-4 hidden"></p>
                    <p id="success-msg" class="text-green-500 text-sm mb-4 hidden">密码重置成功，正在跳转...</p>
                    <button
                        type="submit"
                        id="reset-btn"
                        class="w-full px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition font-medium"
                    >
                        重置密码
                    </button>
                </form>
            ) : (
                <form id="forgot-form">
                    <div class="mb-4">
                        <label for="username" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            用户名
                        </label>
                        <input
                            type="text"
                            id="username"
                            name="username"
                            required
                            class="w-full px-3 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-blue-500"
                            placeholder="请输入用户名"
                        />
                    </div>
                    <p id="success-msg-forgot" class="text-green-500 text-sm mb-4 hidden">
                        如果该用户名存在且已设置邮箱，重置链接已发送到注册邮箱。如未收到邮件，请联系管理员或通过 CLI 脚本重置密码。
                    </p>
                    <p class="text-xs opacity-50 mt-2">
                        提示：请先在管理面板的"管理员管理"中设置您的邮箱地址。
                    </p>
                    <p id="error-msg-forgot" class="text-red-500 text-sm mb-4 hidden"></p>
                    <button
                        type="submit"
                        id="send-btn"
                        class="w-full px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition font-medium"
                    >
                        发送重置链接
                    </button>
                </form>
            )}
        </div>
        <p class="text-center text-gray-500 dark:text-gray-400 text-sm mt-4">
            <a href="/admin/" class="text-sm opacity-60 hover:opacity-80 transition-opacity">返回登录</a>
        </p>
    </div>

    <script>
        const hasToken = new URLSearchParams(window.location.search).has('token');

        if (hasToken) {
            const form = document.getElementById('reset-form') as HTMLFormElement;
            const errorMsg = document.getElementById('error-msg') as HTMLParagraphElement;
            const successMsg = document.getElementById('success-msg') as HTMLParagraphElement;
            const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const token = (document.getElementById('token') as HTMLInputElement).value;
                const newPassword = (document.getElementById('new-password') as HTMLInputElement).value;
                const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;

                if (!newPassword || !confirmPassword) return;
                if (newPassword !== confirmPassword) {
                    errorMsg.textContent = '两次输入的密码不一致';
                    errorMsg.classList.remove('hidden');
                    return;
                }
                if (newPassword.length < 8) {
                    errorMsg.textContent = '密码长度至少为8位';
                    errorMsg.classList.remove('hidden');
                    return;
                }

                resetBtn.disabled = true;
                resetBtn.textContent = '重置中...';
                errorMsg.classList.add('hidden');
                successMsg.classList.add('hidden');

                try {
                    const res = await fetch('/api/admin/auth/reset-password/', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ token, newPassword }),
                    });

                    if (res.ok) {
                        successMsg.classList.remove('hidden');
                        window.setTimeout(() => {
                            window.location.href = '/admin/';
                        }, 1500);
                    } else {
                        const errData = await res.json().catch(() => null);
                        errorMsg.textContent = errData?.error || '重置失败，请重试';
                        errorMsg.classList.remove('hidden');
                    }
                } catch {
                    errorMsg.textContent = '网络错误，请重试';
                    errorMsg.classList.remove('hidden');
                } finally {
                    resetBtn.disabled = false;
                    resetBtn.textContent = '重置密码';
                }
            });
        } else {
            const form = document.getElementById('forgot-form') as HTMLFormElement;
            const successMsg = document.getElementById('success-msg-forgot') as HTMLParagraphElement;
            const errorMsg = document.getElementById('error-msg-forgot') as HTMLParagraphElement;
            const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const username = (document.getElementById('username') as HTMLInputElement).value.trim();
                if (!username) return;

                sendBtn.disabled = true;
                sendBtn.textContent = '发送中...';
                errorMsg.classList.add('hidden');
                successMsg.classList.add('hidden');

                try {
                    const res = await fetch('/api/admin/auth/forgot-password/', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ username }),
                    });

                    // 无论成功与否都显示相同提示（安全考虑）
                    successMsg.classList.remove('hidden');
                } catch {
                    errorMsg.textContent = '网络错误，请重试';
                    errorMsg.classList.remove('hidden');
                } finally {
                    sendBtn.disabled = false;
                    sendBtn.textContent = '发送重置链接';
                }
            });
        }
    </script>
</body>
</html>
