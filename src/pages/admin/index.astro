---
export const prerender = false;

import "../../styles/main.css";
---

<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>管理面板 - 登录</title>
    <style is:global>
        @reference "tailwindcss";
    </style>
</head>
<body class="min-h-screen bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
    <div class="w-full max-w-sm">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-8">
            <h1 class="text-2xl font-bold text-center text-gray-900 dark:text-white mb-6">
                管理面板
            </h1>
            <form id="login-form">
                <div class="mb-4">
                    <label for="username" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        用户名
                    </label>
                    <input
                        type="text"
                        id="username"
                        name="username"
                        required
                        class="w-full px-3 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-blue-500"
                        placeholder="请输入用户名"
                    />
                </div>
                <div class="mb-4">
                    <label for="password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        密码
                    </label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        required
                        class="w-full px-3 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-blue-500"
                        placeholder="请输入密码"
                    />
                </div>
                <p id="error-msg" class="text-red-500 text-sm mb-4 hidden">用户名或密码错误</p>
                <div id="captcha-container" class="mb-4" style="display:none;"></div>
                <button
                    type="submit"
                    id="login-btn"
                    class="w-full px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition font-medium"
                >
                    登录
                </button>
            </form>
            <div class="mt-3 text-center">
                <a href="/admin/reset-password/" class="text-sm opacity-60 hover:opacity-80 transition-opacity">忘记密码？</a>
            </div>
        </div>
        <p class="text-center text-gray-500 dark:text-gray-400 text-sm mt-4">
            仅限管理员访问
        </p>
    </div>

    <script>
        import { loadCaptchaSdk, renderCaptcha, getCaptchaToken, removeCaptcha } from '@utils/captcha-client';

        type CaptchaProvider = 'turnstile' | 'hcaptcha';
        let captchaProvider: CaptchaProvider | 'none' = 'none';
        let captchaSiteKey = '';
        let captchaEnabled = false;
        let captchaWidgetId: string | null = null;

        // 从后端 API 获取验证码配置
        async function fetchCaptchaConfig() {
            try {
                const res = await fetch('/api/admin/captcha-config/');
                if (res.ok) {
                    const data = await res.json();
                    captchaEnabled = data.enabled === true;
                    captchaProvider = data.provider || 'none';
                    captchaSiteKey = data.siteKey || '';
                }
            } catch { /* ignore */ }
        }

        function resetCaptcha() {
            if (!captchaEnabled || captchaProvider === 'none') return;
            const container = document.getElementById('captcha-container');
            if (!container) return;
            if (captchaWidgetId) {
                removeCaptcha(captchaProvider, captchaWidgetId);
                captchaWidgetId = null;
            }
            captchaWidgetId = renderCaptcha(container, captchaProvider, captchaSiteKey);
        }

        async function initCaptcha() {
            await fetchCaptchaConfig();
            if (!captchaEnabled || captchaProvider === 'none' || !captchaSiteKey) return;

            const container = document.getElementById('captcha-container');
            if (!container) return;
            container.style.display = 'block';

            try {
                await loadCaptchaSdk(captchaProvider);
                captchaWidgetId = renderCaptcha(container, captchaProvider, captchaSiteKey);
            } catch {
                console.error('Failed to load captcha SDK');
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initCaptcha);
        } else {
            initCaptcha();
        }
        document.addEventListener('swup:page:view', initCaptcha);
        if (window.swup && window.swup.hooks) {
            window.swup.hooks.on('page:view', initCaptcha);
        }

        const form = document.getElementById('login-form') as HTMLFormElement;
        const errorMsg = document.getElementById('error-msg') as HTMLParagraphElement;
        const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const username = (document.getElementById('username') as HTMLInputElement).value.trim();
            const password = (document.getElementById('password') as HTMLInputElement).value;
            if (!username || !password) return;

            const captchaToken = captchaEnabled && captchaProvider !== 'none'
                ? getCaptchaToken(document, captchaProvider) || ''
                : '';
            if (captchaEnabled && captchaProvider !== 'none' && !captchaToken) {
                errorMsg.textContent = '请先完成验证码验证';
                errorMsg.classList.remove('hidden');
                return;
            }

            loginBtn.disabled = true;
            loginBtn.textContent = '登录中...';
            errorMsg.classList.add('hidden');

            try {
                const res = await fetch('/api/admin/auth/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password, captchaToken }),
                });

                if (res.ok) {
                    window.location.href = '/admin/dashboard/';
                } else {
                    const errData = await res.json().catch(() => null);
                    errorMsg.textContent = errData?.error || '用户名或密码错误';
                    errorMsg.classList.remove('hidden');
                    // 验证码失败时从响应更新本地状态并重置验证码组件
                    if (errData?.captchaInfo?.enabled) {
                        captchaEnabled = true;
                        captchaProvider = errData.captchaInfo.provider || captchaProvider;
                        captchaSiteKey = errData.captchaInfo.siteKey || captchaSiteKey;
                        resetCaptcha();
                    }
                }
            } catch {
                errorMsg.textContent = '网络错误，请重试';
                errorMsg.classList.remove('hidden');
            } finally {
                loginBtn.disabled = false;
                loginBtn.textContent = '登录';
            }
        });
    </script>
</body>
</html>
