# OpenRouter API Key for AI Summary feature
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-key-here

# OpenAI-compatible API Key (for OpenAI provider)
OPENAI_API_KEY=

# Custom AI Provider API Key and Base URL
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=

# Database configuration
DB_TYPE=sqlite
DATABASE_URL=postgresql://user:password@localhost:5432/fuwari_blog

# Resend API key for password reset emails
RESEND_API_KEY=re_xxxxxxxx
SMTP_FROM=noreply@your-domain.com
SITE_URL=https://your-blog.com

# Cloudflare Turnstile (optional, enables CAPTCHA on login)
TURNSTILE_SECRET_KEY=

# hCaptcha (optional, alternative to Turnstile)
HCAPTCHA_SECRET_KEY=
