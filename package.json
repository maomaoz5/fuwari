{
  "name": "fuwari",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "dev:admin": "vite --config src/admin-spa/vite.config.ts",
    "build:admin": "vite build --config src/admin-spa/vite.config.ts",
    "check": "tsc --noEmit",
    "build": "pnpm build:admin && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "tsc --noEmit --isolatedDeclarations",
    "new-post": "node scripts/new-post.js",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/node": "^11.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "9.0.1",
    "@expressive-code/core": "^0.44.1",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.86",
    "@iconify/svelte": "^5.2.2",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.5",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.2.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.3",
    "gray-matter": "^4.0.3",
    "hastscript": "^9.0.1",
    "hono": "^4.13.13",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.0",
    "mdast-util-to-string": "^4.0.0",
    "overlayscrollbars": "^2.16.0",
    "pagefind": "^1.5.2",
    "pg": "^8.23.1",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-github-admonitions-to-directives": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "resend": "^6.32.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.3",
    "stylus": "^0.64.0",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.10",
    "@biomejs/biome": "2.5.6",
    "@rollup/plugin-yaml": "^5.0.0",
